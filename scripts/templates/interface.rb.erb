module LanguageServer
  module Protocol
    module Interface
      <%- if comment -%>
      #
<%= comment.indent(6) %>
      #
      <%- end -%>
      class <%= name %>
        <%- if properties.any?(&:preserve_falsy) -%>
        UNSPECIFIED = Object.new.freeze
        private_constant :UNSPECIFIED

        <%- end -%>
        def initialize(<%= params %>)
          @attributes = {}

        <%- properties.each do |prop| -%>
          @attributes[:<%= prop.name %>] = <%= prop.local_name %><% if prop.preserve_falsy %> unless <%= prop.local_name %>.equal?(UNSPECIFIED)<% elsif prop.optional %> if <%= prop.local_name %><% end %>
        <%- end -%>

          @attributes.freeze
        end
      <%- properties.each do |prop| -%>

        <%- if prop.comment -%>
        #
<%= prop.comment.indent(8) %>
        #
        <%- end -%>
        # @return [<%= prop.return_type %>]
        def <%= prop.method_name %>
          attributes.fetch(:<%= prop.name %>)
        end
      <%- end -%>

        attr_reader :attributes

        def to_hash
          attributes
        end

        def to_json(*args)
          to_hash.to_json(*args)
        end
      end
    end
  end
end
