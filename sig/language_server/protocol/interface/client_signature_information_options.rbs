module LanguageServer
  module Protocol
    module Interface
      #
      # @since 3.18.0
      #
      class ClientSignatureInformationOptions
        def initialize: (?documentation_format: Array[untyped], ?parameter_information: untyped, ?active_parameter_support: bool, ?no_active_parameter_support: bool) -> void

        @attributes: Hash[Symbol, untyped]
        attr_reader attributes: Hash[Symbol, untyped]

        %a{pure}
        def documentation_format: () -> Array[untyped]

        %a{pure}
        def parameter_information: () -> untyped

        %a{pure}
        def active_parameter_support: () -> bool

        %a{pure}
        def no_active_parameter_support: () -> bool

        def to_hash: () -> Hash[Symbol, untyped]

        def to_json: (*untyped) -> String
      end
    end
  end
end
