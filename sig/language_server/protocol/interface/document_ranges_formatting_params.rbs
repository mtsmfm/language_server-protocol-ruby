module LanguageServer
  module Protocol
    module Interface
      #
      # The parameters of a {@link DocumentRangesFormattingRequest}.
      #
      # @since 3.18.0
      #
      class DocumentRangesFormattingParams
        def initialize: (text_document: untyped, ranges: Array[untyped], options: untyped, ?work_done_token: untyped) -> void

        @attributes: Hash[Symbol, untyped]
        attr_reader attributes: Hash[Symbol, untyped]

        %a{pure}
        def text_document: () -> untyped

        %a{pure}
        def ranges: () -> Array[untyped]

        %a{pure}
        def options: () -> untyped

        %a{pure}
        def work_done_token: () -> untyped

        def to_hash: () -> Hash[Symbol, untyped]

        def to_json: (*untyped) -> String
      end
    end
  end
end
