module LanguageServer
  module Protocol
    module Interface
      #
      # @since 3.18.0
      #
      class ClientCompletionItemOptions
        def initialize: (?snippet_support: bool, ?commit_characters_support: bool, ?documentation_format: Array[untyped], ?deprecated_support: bool, ?preselect_support: bool, ?tag_support: untyped, ?insert_replace_support: bool, ?resolve_support: untyped, ?insert_text_mode_support: untyped, ?label_details_support: bool) -> void

        @attributes: Hash[Symbol, untyped]
        attr_reader attributes: Hash[Symbol, untyped]

        %a{pure}
        def snippet_support: () -> bool

        %a{pure}
        def commit_characters_support: () -> bool

        %a{pure}
        def documentation_format: () -> Array[untyped]

        %a{pure}
        def deprecated_support: () -> bool

        %a{pure}
        def preselect_support: () -> bool

        %a{pure}
        def tag_support: () -> untyped

        %a{pure}
        def insert_replace_support: () -> bool

        %a{pure}
        def resolve_support: () -> untyped

        %a{pure}
        def insert_text_mode_support: () -> untyped

        %a{pure}
        def label_details_support: () -> bool

        def to_hash: () -> Hash[Symbol, untyped]

        def to_json: (*untyped) -> String
      end
    end
  end
end
