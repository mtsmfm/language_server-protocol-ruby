module LanguageServer
  module Protocol
    module Constant
      #
      # Code action tags are extra annotations that tweak the behavior of a code action.
      #
      # @since 3.18.0
      #
      module CodeActionTag
        #
        # Marks the code action as LLM-generated.
        #
        LLM_GENERATED: 1
      end
    end
  end
end
